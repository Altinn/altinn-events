# For the local Aspire stack (tools/aspire). Use it as .env in the Bruno app, or pass it with --env-file to the CLI, with the Local environment.
TOKEN_BASIC_AUTH_USER=mock
TOKEN_BASIC_AUTH_PW=mock
TOKEN_URL=http://localhost:5081

# Subscriptions with this endpoint go to the webhook receiver in wiremock-platform.
ALTINN_SLACK_WEBHOOK=https://localhost:5084/webhooks/ok/slack
