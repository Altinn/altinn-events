<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<OutputType>Exe</OutputType>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="Moq" Version="4.21.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="xunit.v3" Version="3.2.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- The mocks are tested against the API's own clients, so they answer in the format the API reads. -->
		<ProjectReference Include="..\..\..\src\Events\Altinn.Platform.Events.csproj" />
		<ProjectReference Include="..\..\src\Altinn.Platform.Events.Tools.MockAuth\Altinn.Platform.Events.Tools.MockAuth.csproj" />
		<ProjectReference Include="..\..\src\Altinn.Platform.Events.Tools.PlatformMocks\Altinn.Platform.Events.Tools.PlatformMocks.csproj" />
	</ItemGroup>

</Project>
